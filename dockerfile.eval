# Use a lightweight python image
FROM python:3.9-slim

WORKDIR /app

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install torch --index-url https://download.pytorch.org/whl/cpu # Install CPU version to save space

# Copy the evaluation script and the saved test data from your local machine
COPY eval.py .
COPY test_dataset.pt .
COPY id2label.json .
COPY test_labels.json .

# Define your Hugging Face model repository ID
ENV MODEL_REPO_ID="your-username/my-fine-tuned-classifier"

# Run the evaluation script automatically when the container starts
CMD ["python", "eval.py"]
